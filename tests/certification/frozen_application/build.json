{
  "app_name": "VeltoFrozenSmoke",
  "version": "0.1.0",
  "entry_point": "main.py",
  "framework": "tkinter",
  "bundle": "onedir",
  "resource_protection": {
    "enabled": true
  },
  "optimization": {
